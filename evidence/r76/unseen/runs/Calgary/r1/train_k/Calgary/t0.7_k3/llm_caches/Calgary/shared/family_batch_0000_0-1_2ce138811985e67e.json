            "code": "def forward(groups):\n    from datetime import datetime\n    timestamp = datetime.strptime(groups[0], '%d/%b/%Y:%H:%M:%S')\n    timezone_offset = int(groups[1][:3]) * 3600 + int(groups[1][3:]) * 60\n    micros_since_epoch = int((timestamp.timestamp() - timezone_offset) * 1000000)\n    return {'stored': [micros_since_epoch], 'layout': []}\n\ndef inverse(record):\n    from datetime import datetime, timedelta\n    micros_since_epoch = record['stored'][0]\n    timestamp = datetime.utcfromtimestamp(micros_since_epoch / 1000000)\n    timezone_offset = timedelta(hours=micros_since_epoch // 3600000000)\n    offset_hours = int(timezone_offset.total_seconds() // 3600)\n    offset_minutes = int(abs(timezone_offset.total_seconds()) % 3600 / 60)\n    offset_sign = '+' if offset_hours >= 0 else '-'\n    return timestamp.strftime('%d/%b/%Y:%H:%M:%S') + f' {offset_sign}{abs(offset_hours):02}{offset_minutes:02}'"
