          "program": {
            "op": "python_exec",
            "code": "def forward(groups):\n    date = groups[0].replace('.', '-')\n    time_part = groups[1].replace('.', ':')\n    full_datetime = f\"{date}T{time_part}\"\n    dt = datetime.strptime(full_datetime, '%Y-%m-%dT%H:%M:%S.%f')\n    return {'stored': [int(dt.timestamp() * 1000000)], 'layout': []}\n\ndef inverse(record):\n    micros = int(record['stored'][0])\n    dt = datetime.fromtimestamp(micros / 1000000)\n    return dt.strftime('%Y.%m.%d %Y-%m-%d-%H.%M.%S.%f')"
          }
        }
